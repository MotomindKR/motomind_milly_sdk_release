# Six arm angles, base to wrist. Gripper is a separate service.
float64[6] positions
# Optional scalars: [] uses the SDK default; [value] overrides.
float64[] max_vel
float64[] kp
float64[] kd
# All six arm joints; omitted/false preserves the existing behavior.
bool gravity_compensation false
---
bool success
string message
float64 duration_s
